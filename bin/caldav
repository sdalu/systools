#!/usr/bin/env ruby
# frozen_string_literal: true

# caldav -- list, show, insert and modify events on a CalDAV server, and
# set a calendar's name, colour and description.
#
# Credentials: --user/--password, else $CALDAV_USER/$CALDAV_PASSWORD, else
# the ~/.authinfo or ~/.netrc entry for the server host, else (the user)
# $EMAIL or (the password) a prompt.
# The calendar home is found from the user's domain (_caldavs._tcp SRV +
# TXT path=); --calendar picks a calendar in it by id or display name,
# unless --url names the collection outright.
# Without --url the user must be given (--user, $CALDAV_USER or $EMAIL):
# the server is found from it, and only then its ~/.authinfo entry.
#
# Cyrus schedules implicitly: storing an event you organise that has
# ATTENDEEs (add, set, edit, import) mails them the invitation or update.

require "date"
require "fileutils"
require "io/console"
require "json"
require "net/http"
require "openssl"
require "optparse"
require "resolv"
require "securerandom"
require "shellwords"
require "tempfile"
require "time"
require "uri"

require "nokogiri"

module CalDAV
    class Error < StandardError; end

    # A non-2xx answer; status lets callers tell a 412 conflict apart.
    class HTTPError < Error
        attr_reader :status

        def initialize(msg, status)
            super(msg)
            @status = status
        end
    end

    PRODID = "-//sdalu.com//caldav//EN"

    # An iCalendar component kept as its unfolded content lines and nested
    # components, so that whatever the script does not touch (VALARM,
    # X-*, ATTENDEE parameters) round-trips unchanged.
    class Component
        Line = Data.define(:name, :params, :value) do
            def self.parse(text)
                head, value = Component.split_unquoted(text, ":")
                raise Error, "malformed content line: #{text}" if value.nil?

                name, params = Component.split_unquoted(head, ";")
                new(name:, params: params ? ";#{params}" : "",
                    value:)
            end

            def base   = name.split(".").last.upcase
            def to_s   = "#{name}#{params}:#{value}"

            # The value stays raw (iCalendar escapes and all), so that
            # structured values (RRULE, GEO) keep their fields apart.
            def as_json = { name:, params: param_map, value: }

            # ";TZID=Europe/Paris" -> { "TZID" => "Europe/Paris" }; a
            # repeated parameter has its values joined by commas.
            def param_map
                params.split(";").reject(&:empty?)
                      .each_with_object({}) do |param, map|
                    key, value = param.split("=", 2)
                    key   = key.upcase
                    value = value.to_s.delete('"')
                    map[key] = map.key?(key) ? "#{map[key]},#{value}" : value
                end
            end

            def param(key)
                found = params.split(";")
                              .find { it.upcase.start_with?("#{key}=") }
                found&.split("=", 2)&.last&.delete('"')
            end

            def named?(wanted)
                wanted = wanted.upcase
                wanted.include?(".") ? name.upcase == wanted : base == wanted
            end

            # Every parameter of wanted (";TYPE=home") is among ours.
            def params?(wanted)
                have = params.upcase.split(";")
                wanted.upcase.split(";").reject(&:empty?)
                      .all? { have.include?(it) }
            end
        end

        ITEMS = %w[VEVENT VTODO VJOURNAL].freeze

        def self.split_unquoted(text, sep)
            quoted = false
            text.each_char.with_index do |c, i|
                quoted = !quoted if c == '"'
                return [text[...i], text[(i + 1)..]] if c == sep && !quoted
            end
            [text, nil]
        end

        # Every top-level component in text (normally VCALENDARs).
        def self.parse_all(text)
            stack = [new("")]
            text = text.delete_prefix("\uFEFF").gsub(/\r?\n[ \t]/, "")
            text.each_line(chomp: true) do |raw|
                next if raw.strip.empty?

                nest(stack, Line.parse(raw.chomp("\r")))
            end
            raise Error, "unterminated #{stack.last.name}" if stack.size > 1

            stack.first.children
        end

        def self.nest(stack, line)
            case line.base
            when "BEGIN"
                stack << new(line.value.upcase)
                stack[-2].children << stack.last
            when "END"
                raise Error, "unexpected END:#{line.value}" if
                    stack.size < 2 || stack.last.name != line.value.upcase

                stack.pop
            else
                stack.last.lines << line
            end
        end

        def self.parse(text)
            all = parse_all(text)
            raise Error, "expected one VCALENDAR" unless
                all.size == 1 && all.first.name == "VCALENDAR"

            all.first
        end

        attr_reader :name, :lines, :children

        def initialize(name, lines = [], children = [])
            @name     = name
            @lines    = lines
            @children = children
        end

        def line(name) = lines.find { it.base == name }
        def [](name)   = line(name)&.value
        def all(name)  = lines.select { it.base == name }.map(&:value)
        def text(name) = unescape(self[name] || "")
        def items      = children.select { ITEMS.include?(it.name) }
        def parts      = children.reject { it.name == "VTIMEZONE" }
        def walk       = [self, *children.flat_map(&:walk)]

        def as_json
            { name:, properties: lines.map(&:as_json),
              components: children.map(&:as_json) }
        end

        # The item a VCALENDAR is about: the one without a RECURRENCE-ID
        # (the series master), else the first override.
        def main
            return self unless name == "VCALENDAR"

            items.find { it["RECURRENCE-ID"].nil? } || items.first
        end

        def uid     = main&.[]("UID")
        def summary = main&.text("SUMMARY").to_s

        def unescape(value)
            value.gsub(/\\([,;\\nN])/) do
                c = Regexp.last_match(1)
                "nN".include?(c) ? "\n" : c
            end
        end

        def add(spec)
            @lines << Line.parse(spec)
        end

        def set(spec)
            line = Line.parse(spec)
            delete(line.name)
            @lines << line
        end

        # spec is NAME[;PARAM...][:VALUE]; returns how many lines went.
        def delete(spec)
            head, value = Component.split_unquoted(spec, ":")
            name, params = Component.split_unquoted(head, ";")
            count = @lines.size
            @lines.reject! do
                it.named?(name) && it.params?(params.to_s) &&
                    (value.nil? || it.value == value)
            end
            count - @lines.size
        end

        def touch
            now = Time.now.utc.strftime("%Y%m%dT%H%M%SZ")
            set("DTSTAMP:#{now}")
            set("LAST-MODIFIED:#{now}")
        end

        def to_s
            body = ["BEGIN:#{name}", *lines.map { fold(it.to_s) }]
            "#{body.join("\r\n")}\r\n#{children.map(&:to_s).join}" \
                "END:#{name}\r\n"
        end

        private

        # Fold at 75 octets without splitting a UTF-8 character.
        def fold(line)
            out   = [+""]
            limit = 75
            line.each_char do |c|
                if out.last.bytesize + c.bytesize > limit
                    out << +" "
                    limit = 75
                end
                out.last << c
            end
            out.join("\r\n")
        end
    end

    # DATE and DATE-TIME values, read as local Times and written in the
    # local zone (by reference: Cyrus needs no VTIMEZONE for an IANA name).
    module When
        module_function

        ZONEINFO = "/usr/share/zoneinfo"
        DATE     = /\A(\d{4})(\d\d)(\d\d)\z/
        STAMP    = /\A(\d{4})(\d\d)(\d\d)T(\d\d)(\d\d)(\d\d)(Z?)\z/
        RELATIVE = /\A(?:(today|tomorrow)|\+(\d+)d?)(?:\s+|\z)/i
        PERIOD   = /\A([+-])?P(?:(\d+)W)?(?:(\d+)D)?
                    (?:T(?:(\d+)H)?(?:(\d+)M)?(?:(\d+)S)?)?\z/x

        # Outlook's names for the zones most likely to turn up here.
        WINDOWS  = {
            "Romance Standard Time" => "Europe/Paris",
            "W. Europe Standard Time" => "Europe/Berlin",
            "Central Europe Standard Time" => "Europe/Budapest",
            "Central European Standard Time" => "Europe/Warsaw",
            "GMT Standard Time" => "Europe/London",
            "Eastern Standard Time" => "America/New_York",
            "Central Standard Time" => "America/Chicago",
            "Mountain Standard Time" => "America/Denver",
            "Pacific Standard Time" => "America/Los_Angeles",
            "UTC" => "UTC"
        }.freeze

        # [Time, all_day] for a DTSTART-like content line.
        def of(line)
            if (m = line.value.match(DATE))
                return [Time.local(*m.captures.map(&:to_i)), true]
            end

            m = line.value.match(STAMP) or
                raise Error, "bad date-time: #{line}"
            parts = m.captures.first(6).map(&:to_i)
            return [Time.utc(*parts).localtime, false] if m[7] == "Z"

            # Through a Rational, or the Time keeps the zone's offset.
            [Time.at(zoned(line.param("TZID")) { Time.local(*parts).to_r }),
             false]
        end

        # The IANA name for a TZID: as is, its tail when vendor-prefixed
        # ("/citadel.org/20190914_1/Europe/London"), or an Outlook name
        # mapped; nil when unknown, and the time is then read as local.
        def iana(tzid)
            return if tzid.nil? || tzid.include?("..")
            return WINDOWS[tzid] if WINDOWS.key?(tzid)

            words = tzid.split("/").reject(&:empty?)
            words.each_index.map { words[it..].join("/") }
                 .find { File.file?(File.join(ZONEINFO, it)) }
        end

        # Runs the block with TZ set to tzid's zone, when we know it.
        def zoned(tzid)
            zone = iana(tzid) or return yield

            begin
                saved = ENV.fetch("TZ", nil)
                ENV["TZ"] = zone
                yield
            ensure
                ENV["TZ"] = saved
            end
        end

        # [Time, all_day] from the user: "2026-10-15" is a whole day;
        # "2026-10-15 14:00", "14:00", "tomorrow 9:30", "+3 10:00" times.
        # A bare time falls on base's day (today by default).
        def parse(text, base = Time.now)
            if (m = text.match(RELATIVE))
                days = m[2]&.to_i || (m[1].casecmp?("tomorrow") ? 1 : 0)
                base = Date.today + days
                rest = m.post_match.strip
                return [base.to_time, true] if rest.empty?

                text = "#{base} #{rest}"
            end
            return [Date.iso8601(text).to_time, true] if
                text.match?(/\A\d{4}-\d\d-\d\d\z/)

            [Time.parse(text, base), false]
        end

        # "DTSTART;VALUE=DATE:20261015", ";TZID=Europe/Paris:...T140000":
        # the wall clock in tzid (the local zone by default; one we
        # cannot name is the local wall clock, as of() read it).
        def prop(name, time, all_day, tzid = local_zone)
            return "#{name};VALUE=DATE:#{time.strftime("%Y%m%d")}" if all_day
            return "#{name}:#{time.utc.strftime("%Y%m%dT%H%M%SZ")}" if
                tzid.nil?

            wall = zoned(tzid) { Time.at(time.to_r).strftime("%Y%m%dT%H%M%S") }
            "#{name};TZID=#{tzid}:#{wall}"
        end

        def local_zone
            tz = ENV.fetch("TZ", "").delete_prefix(":")
            return tz unless tz.empty?

            File.readlink("/etc/localtime")[%r{zoneinfo/(.+)\z}, 1]
        rescue SystemCallError
            nil
        end

        # Moves [time, all_day] on by seconds (whole days for a date).
        def shift((time, all_day), seconds)
            return [time + seconds, false] unless all_day

            days = [(seconds / 86_400.0).round, 1].max
            [(time.to_date + days).to_time, true]
        end

        # "90" or "90m", "1h30m", "2d", "1w" -> seconds.
        def length(text)
            return text.to_i * 60 if text.match?(/\A\d+\z/)
            raise ArgumentError, "bad duration: #{text}" unless
                text.match?(/\A(?:\s*\d+\s*[wdhm])+\s*\z/i)

            unit = { "w" => 604_800, "d" => 86_400, "h" => 3600, "m" => 60 }
            text.scan(/(\d+)\s*([wdhm])/i)
                .sum { |n, u| n.to_i * unit[u.downcase] }
        end

        # "PT1H30M", "P1D", "-PT15M" -> seconds.
        def seconds(period)
            m = period.match(PERIOD) or
                raise Error, "bad duration: #{period}"
            sum = [604_800, 86_400, 3600, 60, 1]
                  .zip(m.captures.drop(1)).sum { |unit, n| unit * n.to_i }
            m[1] == "-" ? -sum : sum
        end

        # seconds -> "PT15M", "P1DT2H".
        def duration(seconds)
            days, rest = seconds.divmod(86_400)
            hours, rest = rest.divmod(3600)
            time = [[hours, "H"], [rest / 60, "M"]]
                   .select { it[0].positive? }.join
            date = days.positive? ? "#{days}D" : ""
            out  = "P#{date}#{"T#{time}" unless time.empty?}"
            out == "P" ? "PT0M" : out
        end
    end

    # The HTTP side: one keep-alive connection to the calendar home.
    class Client
        NS = { "d" => "DAV:", "c" => "urn:ietf:params:xml:ns:caldav",
               "a" => "http://apple.com/ns/ical/" }.freeze

        # The collection properties props reads and sets, by option.
        SETTABLE = { name: %w[d displayname],
                     color: %w[a calendar-color],
                     description: %w[c calendar-description] }.freeze

        Calendar = Data.define(:url, :name, :components) do
            def id = File.basename(url.path)
        end

        PROPS = <<~XML.freeze
            <d:propfind xmlns:d="DAV:" xmlns:c="#{NS["c"]}">
              <d:prop><d:displayname/><d:resourcetype/>
                <c:supported-calendar-component-set/></d:prop>
            </d:propfind>
        XML

        def initialize(home, user, password, calendar:, debug: false)
            @home = home
            @calendar = calendar
            @user = user
            @password = password
            @http = Net::HTTP.new(home.host, home.port)
            @http.use_ssl = home.scheme == "https"
            @http.set_debug_output($stderr) if debug
        end

        # The collection --calendar or --url picked, found on first use.
        def url = @url ||= locate(@calendar)

        def calendars
            @calendars ||= begin
                res = request("PROPFIND", @home, PROPS, "Depth" => "1")
                Nokogiri::XML(res.body)
                        .xpath("//d:response[.//d:resourcetype/c:calendar]",
                               NS).map { calendar(it) }
            end
        end

        # [ [href, etag, VCALENDAR], ... ] in the collection at, those
        # with comp items overlapping range ({start:, end:}) if given; expand
        # turns each series into its instances, in UTC.
        def objects(comp: nil, range: nil, expand: false, at: url)
            res = request("REPORT", at, query(comp, range, expand),
                          "Depth" => "1")
            Nokogiri::XML(res.body).xpath("//d:response", NS).filter_map do
                data = it.at_xpath(".//c:calendar-data", NS)&.text
                next if data.nil? || data.empty?

                [it.at_xpath("d:href", NS).text,
                 it.at_xpath(".//d:getetag", NS)&.text,
                 Component.parse(data)]
            end
        end

        def get(href)
            res = request("GET", url + href)
            [Component.parse(res.body.force_encoding("UTF-8")), res["ETag"]]
        end

        # etag nil: create only (If-None-Match), else update only that version.
        def put(href, object, etag = nil)
            cond = etag ? { "If-Match" => etag } : { "If-None-Match" => "*" }
            request("PUT", url + href, object.to_s,
                    { "Content-Type" => "text/calendar; charset=utf-8" }
                    .merge(cond))
        end

        def delete(href, etag)
            request("DELETE", url + href, nil, "If-Match" => etag)
        end

        # { name:, color:, description: } of the collection; nil if unset.
        def properties(at = url)
            res = request("PROPFIND", at, xml(:propfind) do |b|
                b["d"].prop { SETTABLE.each_value { |ns, n| b[ns].send(n) } }
            end, "Depth" => "0")
            doc = Nokogiri::XML(res.body)
            SETTABLE.transform_values do |ns, n|
                doc.at_xpath("//d:propstat[contains(d:status, ' 200')]" \
                             "/d:prop/#{ns}:#{n}", NS)&.text
            end
        end

        # values as for properties; an empty one removes the property.
        def proppatch(values, at = url)
            res  = request("PROPPATCH", at, propertyupdate(values))
            refused = Nokogiri::XML(res.body)
                           .xpath("//d:propstat[not(contains(d:status, " \
                                  "' 200'))]", NS).flat_map do |stat|
                code = stat.at_xpath("d:status", NS).text.split[1]
                stat.xpath("d:prop/*").map { "#{it.name} (#{code})" }
            end
            raise Error, "PROPPATCH refused: #{refused.join(", ")}" if
                refused.any?
        end

        def propertyupdate(values)
            gone, kept = values.partition { |_, v| v.empty? }
            xml(:propertyupdate) do |b|
                { set: kept, remove: gone }.each do |verb, list|
                    next if list.empty?

                    b["d"].send(verb) do
                        b["d"].prop do
                            list.each do |key, v|
                                ns, n = SETTABLE.fetch(key)
                                b[ns].send(n, v)
                            end
                        end
                    end
                end
            end
        end

        private

        def xml(root)
            Nokogiri::XML::Builder.new do |b|
                b["d"].send(root, NS.transform_keys { "xmlns:#{it}" }) do
                    yield b
                end
            end.to_xml
        end

        def calendar(node)
            Calendar.new(url: @home + node.at_xpath("d:href", NS).text,
                         name: node.at_xpath(".//d:displayname", NS)&.text
                                   .to_s,
                         components: node.xpath(".//c:comp/@name", NS)
                                         .map(&:value))
        end

        # A URL as is; else a calendar id, then a display name.
        def locate(wanted)
            return URI(wanted) if wanted.match?(%r{\Ahttps?://}i)

            hit = calendars.select { it.id == wanted }
            hit = calendars.select { it.name.casecmp?(wanted) } if hit.empty?
            return hit.first.url if hit.size == 1

            raise Error, "#{hit.empty? ? "no" : "more than one"} calendar " \
                         "#{wanted} (have: " \
                         "#{calendars.map(&:name).join(", ")})"
        end

        def query(comp, range, expand)
            span = range&.to_h do |key, at|
                [key, at.utc.strftime("%Y%m%dT%H%M%SZ")]
            end
            Nokogiri::XML::Builder.new do |xml|
                xml["c"].send(:"calendar-query",
                              "xmlns:d" => NS["d"], "xmlns:c" => NS["c"]) do
                    xml["d"].prop do
                        xml["d"].getetag
                        xml["c"].send(:"calendar-data") do
                            xml["c"].expand(span) if expand && span
                        end
                    end
                    filter(xml, comp, span)
                end
            end.to_xml
        end

        def filter(xml, comp, span)
            xml["c"].filter do
                xml["c"].send(:"comp-filter", name: "VCALENDAR") do
                    next if comp.nil?

                    xml["c"].send(:"comp-filter", name: comp) do
                        xml["c"].send(:"time-range", span) if span
                    end
                end
            end
        end

        def request(verb, uri, body = nil, headers = {})
            req = Net::HTTPGenericRequest.new(verb, !body.nil?, true,
                                              uri.request_uri, headers)
            req.basic_auth(@user, @password)
            req["Content-Type"] ||= "application/xml; charset=utf-8" if body
            req.body = body
            res = @http.request(req)
            return res if res.is_a?(Net::HTTPSuccess)

            raise HTTPError.new("#{verb} #{uri.path}: #{res.code} " \
                                "#{res.message}#{reason(res)}", res.code.to_i)
        end

        # The precondition a DAV error body names, e.g. valid-calendar-data.
        def reason(res)
            return "" unless res["Content-Type"]&.include?("xml")

            err = Nokogiri::XML(res.body).at_xpath("/d:error/*[1]", NS)
            err ? " (#{err.name})" : ""
        rescue Nokogiri::XML::SyntaxError
            ""
        end
    end

    # Where the calendar home lives and who we are.
    module Locate
        module_function

        def discover(user)
            domain = user.split("@", 2)[1] or
                raise Error, "cannot discover the server: user has no domain"
            entry = "_caldavs._tcp.#{domain}"
            Resolv::DNS.open do |dns|
                srv = dns.getresources(entry, Resolv::DNS::Resource::IN::SRV)
                         .min_by { [it.priority, -it.weight] } or
                    raise Error, "no SRV record for #{entry}"
                path = txt_path(dns, entry) || "/"
                URI::HTTPS.build(host: srv.target.to_s, port: srv.port,
                                 path: "#{path.chomp("/")}/user/#{user}/")
            end
        end

        def txt_path(dns, entry)
            dns.getresources(entry, Resolv::DNS::Resource::IN::TXT)
               .flat_map(&:strings).find { it.start_with?("path=") }
               &.delete_prefix("path=")
        end

        # The first entry for host in ~/.authinfo, then ~/.netrc (same
        # syntax; # comments and backslash-continued lines are skipped).
        def netrc(host)
            %w[.authinfo .netrc].each do |name|
                file = File.join(Dir.home, name)
                next unless File.readable?(file)

                entry = netrc_entries(File.binread(file))
                        .find { it["machine"] == host }
                return entry if entry
            end
            {}
        end

        def netrc_entries(text)
            words = text.gsub(/\\\r?\n/, "").lines
                        .reject { it.lstrip.start_with?("#") }
                        .join.split
            words.slice_before("machine").filter_map do
                it.each_slice(2).to_h if it.first == "machine"
            end
        end
    end
end

# ----------------------------------------------------------------------

BACKUP_DIR = "~/.local/share/caldav"

NETWORK_ERRORS = [SocketError, SystemCallError, Timeout::Error,
                  OpenSSL::SSL::SSLError].freeze

$opts = { calendar: "Default", add: [], set: [], delete: [] }
$op   = OptionParser.new do |op|
    op.banner = "CalDAV calendar editor"
    op.separator ""
    op.separator "Usage: #{op.program_name} [options] COMMAND [ARGS]"
    op.separator ""
    op.separator "Commands:"
    op.separator "    calendars             list the calendars (id, name)"
    op.separator "    list [REGEX]          list events from --from to --to,"
    op.separator "                          recurrences expanded (-T: tasks,"
    op.separator "                          all unless --from or --to)"
    op.separator "    show EVENT            print an event's iCalendar"
    op.separator "    add                   create an event from the options"
    op.separator "                          (-T: a task)"
    op.separator "    set EVENT             modify an event from the options"
    op.separator "    edit EVENT            modify an event in $EDITOR"
    op.separator "    import FILE|-         create or update (by UID) events"
    op.separator "    delete EVENT          delete an event (a whole series)"
    op.separator "    backup [FILE|-]       save the calendar as one .ics"
    op.separator "                          (default ./CALENDAR-TIMESTAMP.ics)"
    op.separator "    props                 show the calendar's name, colour"
    op.separator "                          and description, or change them"
    op.separator "                          with --name, --color and -D"
    op.separator "                          (an empty value removes one)"
    op.separator ""
    op.separator "EVENT is a UID, or a regex matching exactly one event's"
    op.separator "summary (among those between --from and --to, if given)."
    op.separator "WHEN is 2026-10-15 (a whole day), '2026-10-15 14:00',"
    op.separator "14:00, 'tomorrow 9:30' or '+3 10:00' (in three days)."
    op.separator "LENGTH is minutes, or e.g. 1h30m, 2d, 1w.  LINE is an"
    op.separator "iCalendar content line, e.g. 'CATEGORIES:Work'; it applies"
    op.separator "to the event itself, not its overrides.  A date --end is"
    op.separator "the last day, inclusive.  Moving --start alone keeps the"
    op.separator "length.  Restore a backup with import."
    op.separator ""
    op.separator "Options:"
    op.on "-u", "--user=STRING",     "Username"
    op.on "-p", "--password=STRING", "Password"
    op.on "-U", "--url=URL",         "Calendar collection URL"
    op.on "-c", "--calendar=NAME",   "Calendar id or name (Default)"
    op.on "-A", "--all",             "list: every calendar"
    op.on "-T", "--todo",            "list or add tasks (VTODO)"
    op.on "-f", "--from=WHEN",       "list: window start (today)"
    op.on "-t", "--to=WHEN",         "list: window end (from + 30 days)"
    op.on "-N", "--limit=COUNT", Integer, "list: only the first COUNT entries" do
        it.positive? or raise OptionParser::InvalidArgument, it.to_s
        $opts[:limit] = it
    end
    op.on "-S", "--summary=TEXT",    "Set the summary (title)"
    op.on       "--start=WHEN",      "Set the start"
    op.on       "--end=WHEN",        "Set the end"
    op.on       "--duration=LENGTH", "Set the end from the start"
    op.on       "--due=WHEN",        "Set a task's due time"
    op.on "-l", "--location=TEXT",   "Set the location"
    op.on "-D", "--description=TEXT", "Set the description"
    op.on       "--name=TEXT",       "props: set the display name"
    op.on       "--color=RRGGBB",    "props: set the colour (hex)" do
        it.match?(/\A#?(?:\h{6}|\h{8})?\z/) or
            raise OptionParser::InvalidArgument, it
        $opts[:color] = it.empty? ? it : "##{it.delete_prefix("#")}"
    end
    op.on       "--alarm=LENGTH",    "Add a reminder LENGTH before",
                "(none: remove every reminder)"
    op.on "-a", "--add=LINE",        "Add a property" do
        $opts[:add] << it
    end
    op.on "-s", "--set=LINE", "Replace a property" do
        $opts[:set] << it
    end
    op.on "-d", "--delete=PROP[;PARAM][:VALUE]", "Remove a property" do
        $opts[:delete] << it
    end
    op.on "-B", "--backup[=DIR]", "Save each event before changing it",
          "(-BDIR or --backup=DIR; default #{BACKUP_DIR})" do
        $opts[:backup] = File.expand_path(it || BACKUP_DIR)
    end
    op.on "-n", "--dry-run",         "Print the result, change nothing"
    op.on "-j", "--json",            "Print JSON: one document for list,",
          "calendars and show, one object per",
          "line for changes"
    op.on       "--debug",           "Dump the HTTP exchange"
    op.on "-h", "--help" do
        puts op
        exit
    end
end

def stamp(precise: false)
    Time.now.strftime(precise ? "%Y%m%dT%H%M%S.%6N" : "%Y%m%dT%H%M%S")
end

# Writes text to stem.ics, or stem-1.ics, stem-2.ics... never overwriting.
def write_new(stem, text)
    0.step do |n|
        path = n.zero? ? "#{stem}.ics" : "#{stem}-#{n}.ics"
        File.write(path, text, mode: "wx", perm: 0o600)
        return path
    rescue Errno::EEXIST
        next
    end
end

# The server's version of an event, saved under --backup before it changes.
def keep(object)
    dir = $opts[:backup]
    return if dir.nil? || $opts[:"dry-run"]

    FileUtils.mkdir_p(dir, mode: 0o700)
    write_new(File.join(dir, "#{object.uid.to_s.tr("/", "_")}-" \
                             "#{stamp(precise: true)}"), object.to_s)
end

def die(msg, code = 1)
    warn "#{$op.program_name}: #{msg}"
    exit code
end

# The user (if not given) and password for the server at home: the
# server's entry in ~/.authinfo, then ~/.netrc; for the user, then
# $EMAIL; for the password, then a prompt.
def credentials(home, user)
    pass = $opts[:password] || ENV.fetch("CALDAV_PASSWORD", nil)
    rc   = CalDAV::Locate.netrc(home.host)
    user ||= rc["login"] || email or
        die "no user given (--user, CALDAV_USER, an entry for " \
            "#{home.host} in ~/.authinfo or ~/.netrc, or EMAIL)"
    pass ||= rc["password"] if [nil, user].include?(rc["login"])
    pass ||= IO.console&.getpass("Password for #{user}: ") or
        die "no password for #{user}, and no terminal to ask on"
    [user, pass]
end

def slash(url) = url.end_with?("/") ? url : "#{url}/"

# $EMAIL, the address mail and git tools read; nil when unset or empty.
def email = ENV.fetch("EMAIL", "").then { it.empty? ? nil : it }

# Without --url the server is found from the user's domain, so the
# user must be given; with it, the URL's host can name the user too.
def client
    user = $opts[:user] || ENV.fetch("CALDAV_USER", nil)
    if (url = $opts[:url])
        url  = slash(url)
        home = URI(url).merge("../")
    else
        user ||= email or
            die "no user given (--user, CALDAV_USER or EMAIL), and no " \
                "--url to look one up for"
        home = CalDAV::Locate.discover(user)
    end
    user, pass = credentials(home, user)
    CalDAV::Client.new(home, user, pass, calendar: url || $opts[:calendar],
                                         debug: $opts[:debug])
end

# [from, to] for list; nil elsewhere unless --from or --to was given.
def window(always: false)
    return unless always || $opts[:from] || $opts[:to]

    from = moment(:from) || Date.today.to_time
    to   = moment(:to)   || (from.to_date + 30).to_time
    { start: from, end: to }
end

# A date --to is the last day, inclusive, as for --end.
def moment(key)
    return if $opts[key].nil?

    time, all_day = CalDAV::When.parse($opts[key])
    key == :to && all_day ? (time.to_date + 1).to_time : time
end

def resolve(dav, key)
    die "missing EVENT", 2 if key.nil?
    span = window
    comp = span && ($opts[:todo] ? "VTODO" : "VEVENT")
    all  = dav.objects(comp:, range: span)
    hit = all.select do |href, _, object|
        object.uid == key || File.basename(href, ".ics") == key
    end
    return hit.first if hit.size == 1

    re  = Regexp.new(key, Regexp::IGNORECASE)
    hit = all.select { |_, _, object| re.match?(object.summary) }
    return hit.first if hit.size == 1

    die "no event matches #{key}" if hit.empty?
    die "#{key} is ambiguous:\n" +
        hit.map { |_, _, o| "  #{o.uid}  #{starts(o.main)}  #{o.summary}" }
           .join("\n")
end

def starts(item)
    line = item.line("DTSTART") || item.line("DUE") or return "-"
    time, all_day = CalDAV::When.of(line)
    time.strftime(all_day ? "%F" : "%F %R")
end

# "2026-10-15 14:00-15:00", "2026-10-15..2026-10-17", ...
def span(item)
    from = item.line("DTSTART") or return starts(item)
    from, all_day = CalDAV::When.of(from)
    to = item.line("DTEND")&.then { CalDAV::When.of(it).first }
    to = (to.to_date - 1).to_time if to && all_day
    head = from.strftime(all_day ? "%F" : "%F %R")
    return head if to.nil? || to <= from

    return "#{head}..#{to.strftime("%F")}" if all_day

    same = to.to_date == from.to_date
    "#{head}#{same ? "-" : ".."}#{to.strftime(same ? "%R" : "%F %R")}"
end

# "2026-10-15" for a date, ISO 8601 with the local offset for a time.
def when_json((time, all_day))
    all_day ? time.to_date.iso8601 : time.iso8601
end

# An item's fields, unescaped; a date end is the last day, inclusive,
# as for --end.
def item_json(item)
    from = item.line("DTSTART")&.then { CalDAV::When.of(it) }
    { type: item.name.delete_prefix("V").downcase, uid: item["UID"],
      recurrence_id: item.line("RECURRENCE-ID")
                         &.then { when_json(CalDAV::When.of(it)) },
      summary: item.text("SUMMARY"),
      start: from && when_json(from), end: from && end_json(item, from),
      all_day: from&.last,
      due: item.line("DUE")&.then { when_json(CalDAV::When.of(it)) },
      status: item["STATUS"],
      **%w[LOCATION DESCRIPTION].to_h { [it.downcase.to_sym, item.text(it)] }
                                .reject { |_, v| v.empty? },
      categories: item.all("CATEGORIES")
                      .flat_map { item.unescape(it).split(",") }
                      .then { it.empty? ? nil : it } }.compact
end

def end_json(item, (start, all_day))
    stop = if (line = item.line("DTEND"))
               CalDAV::When.of(line).first
           elsif (period = item["DURATION"])
               CalDAV::When.shift([start, all_day],
                                  CalDAV::When.seconds(period)).first
           end
    return if stop.nil?

    all_day ? (stop.to_date - 1).iso8601 : stop.iso8601
end

def object_json(object, href)
    { href:, **(object.main ? item_json(object.main) : { uid: object.uid }) }
end

# What a change did: a line of text, or with --json one JSON object
# (full: with the whole iCalendar object).
def report(action, href, object, full: false)
    unless $opts[:json]
        return puts("#{action} #{object.uid}  #{object.summary}")
    end

    out = { action:, **object_json(object, href) }
    out[:icalendar] = object.as_json if full
    puts JSON.generate(out)
end

def escape(text) = text.gsub(/([,;\\])/, '\\\\\1').gsub("\n", '\n')

def apply_options(object)
    item = object.main
    if $opts[:start] && object.items.any? { it["RECURRENCE-ID"] }
        die "#{object.uid} has modified occurrences that --start would " \
            "orphan; move it with edit"
    end
    { summary: "SUMMARY", location: "LOCATION",
      description: "DESCRIPTION" }.each do |key, prop|
        item.set("#{prop}:#{escape($opts[key])}") if $opts[key]
    end
    reschedule(item)
    alarm(item, $opts[:alarm]) if $opts[:alarm]
    $opts[:delete].each do
        warn "#{$op.program_name}: -d #{it} matched nothing" if
            item.delete(it).zero?
    end
    $opts[:set].each { item.set(it) }
    $opts[:add].each { item.add(it) }
    item.touch
end

# --start, --end, --duration and --due; a moved event keeps its length,
# and SEQUENCE goes up so that attendees' copies follow.
def reschedule(item)
    keys = %i[start end duration due]
    return if keys.none? { $opts[it] }

    if (start = $opts[:start] && CalDAV::When.parse($opts[:start]))
        length = length_of(item, start[1])
        item.set(CalDAV::When.prop("DTSTART", *start))
    end
    finish(item, length)
    item.set(CalDAV::When.prop("DUE", *CalDAV::When.parse($opts[:due]))) if
        $opts[:due]
    item.set("SEQUENCE:#{item["SEQUENCE"].to_i + 1}")
end

# Seconds from DTSTART to DTEND (or its DURATION), or an hour (a day)
# when it has neither or the start changes between a time and a day.
def length_of(item, all_day)
    default = all_day ? 86_400 : 3600
    from = item.line("DTSTART") or return default
    from, from_day = CalDAV::When.of(from)
    return default if from_day != all_day

    if (to = item.line("DTEND"))
        CalDAV::When.of(to).first - from
    elsif (period = item["DURATION"])
        CalDAV::When.seconds(period)
    else
        default
    end
end

# DTEND from --end, else --duration or the kept length; a computed end
# is written in DTSTART's zone.  It must be of DTSTART's kind and after it.
def finish(item, length)
    return if item.name != "VEVENT"

    line = item.line("DTSTART")
    start, start_day = line && CalDAV::When.of(line)
    stop = stop_of(start, start_day, length)
    return if stop.nil?

    check_stop(start, start_day, stop) if start
    tzid = $opts[:end] ? CalDAV::When.local_zone : line.param("TZID")
    item.delete("DURATION")
    item.set(CalDAV::When.prop("DTEND", *stop, tzid))
end

def stop_of(start, start_day, length)
    if $opts[:end]
        time, all_day = CalDAV::When.parse($opts[:end], start || Time.now)
        return [all_day ? (time.to_date + 1).to_time : time, all_day]
    end
    length = CalDAV::When.length($opts[:duration]) if $opts[:duration]
    return if length.nil? || start.nil?

    CalDAV::When.shift([start, start_day], length)
end

def check_stop(start, start_day, (stop, all_day))
    if all_day != start_day
        die "--end must be a #{start_day ? "date" : "date and time"}, " \
            "like the start", 2
    end
    if stop <= start
        die "the end (#{stop.strftime(all_day ? "%F" : "%F %R")}) is not " \
            "after the start", 2
    end
end

def alarm(item, length)
    item.children.reject! { it.name == "VALARM" }
    return if length.casecmp?("none")

    trigger = "-#{CalDAV::When.duration(CalDAV::When.length(length))}"
    item.children << CalDAV::Component.new(
        "VALARM",
        ["ACTION:DISPLAY", "DESCRIPTION:#{item["SUMMARY"] || "Reminder"}",
         "TRIGGER:#{trigger}"].map { CalDAV::Component::Line.parse(it) }
    )
end

def store(dav, href, object, etag = nil)
    if $opts[:"dry-run"] && !$opts[:json]
        puts object
    elsif $opts[:"dry-run"]
        report(etag ? "would update" : "would create", href, object,
               full: true)
    else
        dav.put(href, object, etag)
        report(etag ? "updated" : "created", href, object)
    end
end

def cmd_calendars(dav)
    if $opts[:json]
        return puts(JSON.pretty_generate(dav.calendars.map do
            { id: it.id, name: it.name, url: it.url.to_s,
              components: it.components }
        end))
    end

    dav.calendars.each do
        puts [it.id, it.name, it.components.join(",")].join("\t")
    end
end

def cmd_list(dav, pattern = nil)
    re   = pattern && Regexp.new(pattern, Regexp::IGNORECASE)
    comp = $opts[:todo] ? "VTODO" : "VEVENT"
    span = window(always: !$opts[:todo])
    rows = sources(dav, comp).flat_map do |label, at|
        dav.objects(comp:, range: span, expand: true, at:)
           .flat_map { it[2].items }
           .select { it.name == comp && listed?(it, re) }
           .map { [label, it] }
    end
    rows = rows.sort_by { |_, item| sort_key(item) }
    rows = rows.first($opts[:limit]) if $opts[:limit]
    if $opts[:json]
        return puts(JSON.pretty_generate(rows.map do |label, item|
            { calendar: label, **item_json(item) }.compact
        end))
    end

    rows.each { |label, item| puts row(label, item).join("\t") }
end

# [[label, url]...]: the selected calendar, or with --all every one
# holding comp, labelled by name.
def sources(dav, comp)
    return [[nil, dav.url]] unless $opts[:all]

    dav.calendars.select { it.components.include?(comp) }
       .map { [it.name, it.url] }
end

def listed?(item, re)
    fields = %w[SUMMARY LOCATION DESCRIPTION CATEGORIES]
    re.nil? || fields.any? { re.match?(item.text(it)) }
end

def sort_key(item)
    line = item.line("DTSTART") || item.line("DUE")
    [line ? CalDAV::When.of(line).first : Time.at(0), item.text("SUMMARY")]
end

def row(label, item)
    fields = if item.name == "VTODO"
                 [starts(item), item["STATUS"] || "-"]
             else
                 [span(item)]
             end
    [*label, *fields, item.text("SUMMARY"), item["UID"]]
end

def cmd_show(dav, key)
    href = resolve(dav, key)[0]
    object, etag = dav.get(href)
    return puts(object) unless $opts[:json]

    puts JSON.pretty_generate({ **object_json(object, href), etag:,
                                icalendar: object.as_json })
end

def cmd_add(dav)
    title = $opts[:set].any? { it.match?(/\ASUMMARY[;:]/i) }
    die "add needs --summary (or a SUMMARY line)", 2 unless
        $opts[:summary] || title
    die "add needs --start", 2 unless $opts[:start] || $opts[:todo]
    uid    = SecureRandom.uuid
    kind   = $opts[:todo] ? "VTODO" : "VEVENT"
    now    = Time.now.utc.strftime("%Y%m%dT%H%M%SZ")
    object = CalDAV::Component.parse(<<~ICS)
        BEGIN:VCALENDAR
        VERSION:2.0
        PRODID:#{CalDAV::PRODID}
        BEGIN:#{kind}
        UID:#{uid}
        CREATED:#{now}
        END:#{kind}
        END:VCALENDAR
    ICS
    apply_options(object)
    store(dav, "#{uid}.ics", object)
end

def cmd_set(dav, key)
    href = resolve(dav, key)[0]
    object, etag = dav.get(href)
    keep(object)
    apply_options(object)
    store(dav, href, object, etag)
end

# The edited file is removed only once the event is stored (or unchanged);
# on any failure it is kept and its path printed.
def cmd_edit(dav, key)
    href = resolve(dav, key)[0]
    object, etag = dav.get(href)
    keep(object)
    file = Tempfile.create(["caldav-", ".ics"])
    file.write(object.to_s.gsub("\r\n", "\n"))
    file.close
    File.delete(file.path) if edit_loop(dav, href, object, etag, file.path)
end

def edit_loop(dav, href, object, etag, path)
    loop do
        system(*ENV.fetch("EDITOR", "vi").shellsplit, path) or
            die "editor failed; your copy is #{path}"
        return save_edit(dav, href, object, etag, path)
    rescue CalDAV::Error, ArgumentError, *NETWORK_ERRORS => e
        warn "#{$op.program_name}: #{e.message}"
        conflict = e.is_a?(CalDAV::HTTPError) && e.status == 412
        if conflict || !again?
            die "#{"the event changed on the server; " if conflict}" \
                "your edits are kept in #{path}"
        end
    end
end

def save_edit(dav, href, object, etag, path)
    edited = CalDAV::Component.parse(File.read(path, encoding: "UTF-8"))
    if edited.to_s == object.to_s
        warn "#{$op.program_name}: unchanged"
    else
        edited.main&.touch
        store(dav, href, edited, etag)
    end
    true
end

def again?
    tty = IO.console or return false
    tty.print "Edit again? [Y/n] "
    !tty.gets.to_s.strip.downcase.start_with?("n")
end

def cmd_import(dav, *files)
    die "import needs a FILE (or - for stdin)", 2 if files.empty?
    known = dav.objects.to_h { |href, etag, obj| [obj.uid, [href, etag]] }
    objects = import_objects(files)
    failed  = objects.count { !import_one(dav, known, it) }
    die "#{failed} of #{objects.size} not imported" if failed.positive?
end

# One object stored; a refusal is reported, and the rest carry on.
def import_one(dav, known, object)
    href, etag = known[object.uid] || ["#{SecureRandom.uuid}.ics", nil]
    keep(dav.get(href).first) if etag
    store(dav, href, object, etag)
    true
rescue CalDAV::HTTPError => e
    warn "#{$op.program_name}: #{object.uid}  #{object.summary}: " \
         "#{e.message}"
    false
end

# The events in files regrouped one VCALENDAR per UID, with the time
# zones they name.  An event is taken whole from the last calendar that
# has it, so a --backup directory restores to its newest copies.
def import_objects(files)
    cals  = files.flat_map { CalDAV::Component.parse_all(read_utf8(it)) }
                 .select { it.name == "VCALENDAR" }
    zones = cals.flat_map(&:children).select { it.name == "VTIMEZONE" }
                .to_h { [it["TZID"], it] }
    newest = {}
    cals.each do |cal|
        cal.parts.each { it.add("UID:#{SecureRandom.uuid}") if it["UID"].nil? }
        cal.parts.group_by { it["UID"] }.each do |uid, group|
            newest[uid] = group.to_h { [it["RECURRENCE-ID"], it] }.values
        end
    end
    newest.values.map { wrap(it, zones) }
end

def wrap(items, zones)
    tzids = items.flat_map(&:walk).flat_map(&:lines)
                 .filter_map { it.param("TZID") }.uniq
    head  = ["VERSION:2.0", "PRODID:#{CalDAV::PRODID}"]
            .map { CalDAV::Component::Line.parse(it) }
    CalDAV::Component.new("VCALENDAR", head,
                          [*tzids.filter_map { zones[it] }, *items])
end

def read_utf8(file)
    return File.read(file, encoding: "UTF-8") unless file == "-"

    $stdin.set_encoding("UTF-8")
    $stdin.read
end

def cmd_delete(dav, key)
    href, etag, object = resolve(dav, key)
    keep(dav.get(href).first)
    if $opts[:"dry-run"]
        report("would delete", href, object)
    else
        dav.delete(href, etag)
        report("deleted", href, object)
    end
end

# One VCALENDAR holding every event, each time zone once.
def cmd_backup(dav, file = nil)
    objects = dav.objects.map { it[2] }.sort_by { it.uid.to_s }
    zones   = objects.flat_map(&:children).select { it.name == "VTIMEZONE" }
                     .to_h { [it["TZID"], it] }
    text    = wrap(objects.flat_map(&:parts), zones).to_s
    if file == "-"
        $stdout.write(text)
    else
        if file
            File.write(file, text, perm: 0o600)
        else
            file = write_new("#{$opts[:calendar].tr("/", "_")}-#{stamp}",
                             text)
        end
        if $opts[:json]
            puts JSON.generate({ file:, count: objects.size })
        else
            warn "#{objects.size} events saved to #{file}"
        end
    end
end

# Without --name, --color or --description, prints the calendar's;
# with them, changes it and prints the result.
def cmd_props(dav)
    values = CalDAV::Client::SETTABLE.keys.filter_map do
        [it, $opts[it]] if $opts[it]
    end.to_h
    if $opts[:"dry-run"]
        return puts(dav.propertyupdate(values)) if values.any?
    elsif values.any?
        dav.proppatch(values)
    end
    props = dav.properties
    return puts(JSON.pretty_generate({ url: dav.url.to_s, **props })) if
        $opts[:json]

    props.each { |key, value| puts "#{key}\t#{value}" }
end

begin
    ARGV.map! { it.dup.force_encoding("UTF-8") }
    $op.parse!(ARGV, into: $opts)
    command = ARGV.shift or die "missing COMMAND (see --help)", 2
    action  = :"cmd_#{command}"
    die "unknown command: #{command}", 2 unless respond_to?(action, true)

    send(action, client, *ARGV)
rescue OptionParser::ParseError, ArgumentError, RegexpError,
       URI::Error => e
    die e.message, 2
rescue Errno::EPIPE
    exit
rescue CalDAV::Error, *NETWORK_ERRORS => e
    die e.message
end
