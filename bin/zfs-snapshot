#!/bin/sh
# zfs-snapshot — take today's snapshot of a dataset and expire old ones
# usage: zfs-snapshot [-r] [-p profile] [-t date] [-n] [-v] [-D] dataset
#
# Meant to run once a day.  Snapshots are named after the date
# (dataset@YYYY-MM-DD).  Profile "default", the only one:
#   - take today's snapshot;
#   - destroy the one from 7 days ago, unless it is a Sunday's;
#   - destroy those 6 months old, so Sunday snapshots expire then.
# Six months back from consecutive days is not always consecutive
# (2026-03-01 maps to 2025-09-01, the day before to 2025-08-28), so
# every date the 6-month mark moved past since yesterday is destroyed.
# Exit status: 0 success, 1 failure, 2 usage error.
# 'local' is not POSIX, but every shell this runs under has it
# shellcheck disable=SC3043
set -eu

readonly version=0.2.1
prog=${0##*/}

# zfs(8) lives in /sbin or /usr/sbin, which Linux cron's PATH and
# an unprivileged Linux user's leave out.
PATH=$PATH:/sbin:/usr/sbin

usage() {
    cat <<EOF
usage: $prog [-r] [-p profile] [-t date] [-n] [-v] [-D] dataset
  -r          snapshot and destroy recursively
  -p profile  snapshotting profile (default: default)
  -t date     act as if today were DATE (YYYY-MM-DD)
  -n          dry run: show what would be done
  -v          report snapshots created and destroyed
  -D          also report the commands run and snapshots skipped
  -h          show this help
  -V          show version
EOF
}

log() {
    printf '%s: %s\n' "$prog" "$*" >&2
}

info() {
    [ "$verbose" -eq 0 ] || log "$*"
}

debug() {
    [ "$debug" -eq 0 ] || log "$*"
}

die() {
    log "$*"
    exit 1
}

# Calendar arithmetic on day numbers (days since 1970-01-01), from
# Howard Hinnant's civil calendar algorithms: date(1) has no date-math
# flag common to FreeBSD (-v) and GNU (-d).

# Print a decimal number without its leading zeros: $(( )) reads 0999
# as an octal number, and 0999 is not one.
decimal() {
    local n="$1"
    while :; do
        case $n in
            0?*) n=${n#0} ;;
            *)   break ;;
        esac
    done
    printf '%s\n' "$n"
}

# Print the day number of YYYY-MM-DD.
day_of() {
    local y m d era yoe doy
    y=${1%%-*}
    m=${1#*-}
    d=${m#*-}
    m=${m%%-*}
    y=$(decimal "$y")
    m=$(decimal "$m")
    d=$(decimal "$d")
    y=$((y - (m <= 2)))
    era=$((y / 400))
    yoe=$((y - era * 400))
    doy=$(((153 * (m > 2 ? m - 3 : m + 9) + 2) / 5 + d - 1))
    printf '%s\n' $((era * 146097 + yoe * 365 + yoe / 4 - yoe / 100 + doy -
        719468))
}

# Print the YYYY-MM-DD of a day number.
date_of() {
    local z era doe yoe doy mp y m d
    z=$(($1 + 719468))
    era=$((z / 146097))
    doe=$((z - era * 146097))
    yoe=$(((doe - doe / 1460 + doe / 36524 - doe / 146096) / 365))
    doy=$((doe - (365 * yoe + yoe / 4 - yoe / 100)))
    mp=$(((5 * doy + 2) / 153))
    d=$((doy - (153 * mp + 2) / 5 + 1))
    m=$((mp < 10 ? mp + 3 : mp - 9))
    y=$((yoe + era * 400 + (m <= 2)))
    printf '%04d-%02d-%02d\n' "$y" "$m" "$d"
}

# Print 0 (Sunday) to 6 (Saturday) for a day number.
weekday_of() {
    printf '%s\n' $((($1 + 4) % 7))
}

# Print the day number N months before a day number, the day of month
# clamped to the length of the target month.
months_before() {
    local date y m d last
    date=$(date_of "$1")
    y=${date%%-*}
    m=${date#*-}
    d=${m#*-}
    m=${m%%-*}
    y=$(decimal "$y")
    m=$(decimal "$m")
    d=$(decimal "$d")
    m=$((y * 12 + m - 1 - $2))
    y=$((m / 12))
    m=$((m % 12 + 1))
    case $m in
    2) last=$((28 + (y % 4 == 0 && (y % 100 != 0 || y % 400 == 0)))) ;;
    4 | 6 | 9 | 11) last=30 ;;
    *) last=31 ;;
    esac
    [ "$d" -le "$last" ] || d=$last
    day_of "$(printf '%04d-%02d-%02d' "$y" "$m" "$d")"
}

snapshot_exists() {
    zfs list -H -t snapshot -o name -- "$1" > /dev/null 2>&1
}

# Run a zfs command, or with -n only show it.
run() {
    if [ "$dry_run" -eq 1 ]; then
        log "would run: zfs $*"
        return 0
    fi
    debug "running: zfs $*"
    zfs "$@"
}

create() {
    local snap="$dataset@$1"
    if snapshot_exists "$snap"; then
        info "$snap already exists"
        return 0
    fi
    info "creating $snap"
    set -- snapshot
    [ "$recursive" -eq 0 ] || set -- "$@" -r
    run "$@" -- "$snap"
}

destroy() {
    local snap="$dataset@$1"
    if ! snapshot_exists "$snap"; then
        debug "no $snap to destroy"
        return 0
    fi
    info "destroying $snap"
    set -- destroy
    [ "$recursive" -eq 0 ] || set -- "$@" -r
    run "$@" -- "$snap"
}

recursive=0
profile=default
today=
dry_run=0
verbose=0
debug=0

while getopts rp:t:nvDhV opt; do
    case $opt in
    r) recursive=1 ;;
    p) profile=$OPTARG ;;
    t) today=$OPTARG ;;
    n) dry_run=1 ;;
    v) verbose=1 ;;
    D) verbose=1; debug=1 ;;
    h) usage; exit 0 ;;
    V) printf '%s %s\n' "$prog" "$version"; exit 0 ;;
    *) usage >&2; exit 2 ;;
    esac
done
shift $((OPTIND - 1))
if [ "$#" -ne 1 ]; then
    usage >&2
    exit 2
fi
dataset=$1

case $profile in
default) ;;
*) log "unsupported profile: $profile"; exit 2 ;;
esac

[ -n "$today" ] || today=$(date +%Y-%m-%d)
case $today in
[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) ;;
*) log "date must be YYYY-MM-DD: $today"; exit 2 ;;
esac
day=$(day_of "$today")
if [ "$(date_of "$day")" != "$today" ]; then
    log "no such date: $today"
    exit 2
fi

zfs list -H -o name -- "$dataset" > /dev/null 2>&1 ||
    die "dataset doesn't exist: $dataset"
debug "using profile $profile, today is $today"

# A failed snapshot leaves the old ones alone, so nothing expires
# without its replacement.
create "$today" || die "failed to create $dataset@$today"

status=0

week_ago=$((day - 7))
if [ "$(weekday_of "$week_ago")" -ne 0 ]; then
    destroy "$(date_of "$week_ago")" || status=1
fi

expired=$(months_before $((day - 1)) 6)
until_day=$(months_before "$day" 6)
while [ "$expired" -lt "$until_day" ]; do
    expired=$((expired + 1))
    destroy "$(date_of "$expired")" || status=1
done

exit "$status"
