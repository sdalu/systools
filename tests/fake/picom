#!/bin/sh
# picom: with -b, "starts": logs its arguments to $PICOM_LOG and creates
# $PICOM_STATE, which pgrep reads as a running picom; $PICOM_FAIL makes
# it fail instead.
printf '%s\n' "$*" >> "$PICOM_LOG"
[ -z "${PICOM_FAIL-}" ] || { printf 'picom: config error\n' >&2; exit 1; }
: > "$PICOM_STATE"
